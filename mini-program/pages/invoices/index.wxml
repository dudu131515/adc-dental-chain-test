<view class="page">
  <view class="page-heading"><view class="page-title">诊疗费用单</view></view>
  <view wx:if="{{loading}}" class="state"><view class="loading-dot"></view><text>正在读取诊疗费用单…</text></view>
  <view wx:elif="{{error}}" class="state state-error">
    <view class="state-title">暂时无法读取</view><text>{{error}}</text>
    <button class="mini-button" bindtap="onShow">重新加载</button>
  </view>
  <view wx:elif="{{profileRequired}}" class="state">
    <view class="state-title">请先完善就诊资料</view><button class="mini-button" bindtap="profile">填写本人资料</button>
  </view>
  <block wx:else>
    <view class="segmented"><button class="{{section === 'all' ? 'active' : ''}}" bindtap="chooseSection" data-section="all">全部 {{counts.all}}</button><button class="{{section === 'unpaid' ? 'active' : ''}}" bindtap="chooseSection" data-section="unpaid">待缴 {{counts.unpaid}}</button><button class="{{section === 'settled' ? 'active' : ''}}" bindtap="chooseSection" data-section="settled">已结清 {{counts.settled}}</button></view>
    <view wx:if="{{!entries.length}}" class="state">
      <view class="state-title">{{section === 'unpaid' ? '暂无待缴费用' : section === 'settled' ? '暂无已结清账单' : '暂无诊疗费用单'}}</view>
      <text>{{section === 'all' ? '门店开立后可在这里查询。' : '可切换其他状态查看。'}}</text>
    </view>
    <button wx:for="{{entries}}" wx:key="invoice_id" class="receipt-card" data-id="{{item.invoice_id}}" bindtap="open">
      <view class="between"><view class="field-label">{{item.invoice_no}}</view><text class="badge">{{item.statusLabel}}</text></view>
      <view class="muted">{{item.visit_date}} · {{item.clinic.name}}</view>
      <view class="fund-line"><text>当前应缴 ¥{{item.accrued}}</text><text>欠款 ¥{{item.outstanding}}</text></view>
    </button>
    <view wx:if="{{moreError}}" class="error-message">{{moreError}}</view>
    <button wx:if="{{nextCursor}}" class="secondary-action" disabled="{{loadingMore}}" loading="{{loadingMore}}" bindtap="more">
      {{moreError ? '重新加载更多' : '加载更多'}}
    </button>
  </block>
</view>
