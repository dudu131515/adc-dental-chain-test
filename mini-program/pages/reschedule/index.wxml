<view class="page">
  <view class="page-title">改期</view>
  <view wx:if="{{loading}}" class="form-hint">正在读取原预约…</view>
  <block wx:if="{{initial}}">
    <appointment-summary appointment="{{initial}}" />
    <view class="section">
      <view class="field-label">新的安排</view>
      <picker range="{{clinics}}" range-key="name" value="{{clinicIndex}}" bindchange="chooseClinic" disabled="{{unknown}}">
        <view class="picker-value">{{clinics[clinicIndex].name}}</view>
      </picker>
      <picker mode="date" value="{{date}}" bindchange="chooseDate" disabled="{{unknown}}"><view class="picker-value">{{date}}</view></picker>
      <picker mode="time" value="{{time}}" bindchange="chooseTime" disabled="{{unknown}}"><view class="picker-value">{{time || '指定时间（选填）'}}</view></picker>
      <button class="secondary-action" bindtap="find" disabled="{{pending || unknown}}">查看可约时段</button>
    </view>
    <button wx:for="{{slots}}" wx:key="id" data-index="{{index}}" bindtap="select"
      class="slot-choice {{selected == index ? 'slot-selected' : ''}}">{{item.dentist_name}} · {{item.time}}</button>
    <view wx:if="{{queried && !slots.length}}" class="form-hint">没有符合条件的时段，原预约仍保留。</view>
    <view wx:if="{{selected >= 0}}" class="section"><view>拟改到 {{proposed}}</view><view class="form-hint">成功后保留原预约号及预约金。</view></view>
    <button class="primary-action" bindtap="submit" disabled="{{pending || selected < 0}}">{{unknown ? '核对改期结果' : '确认改期'}}</button>
  </block>
  <view wx:if="{{error}}" class="error-message">{{error}}</view>
</view>
