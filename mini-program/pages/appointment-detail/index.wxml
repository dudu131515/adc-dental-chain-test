<view class="page">
  <view class="page-title">预约详情</view>
  <view class="form-hint" wx:if="{{loading}}">正在读取预约结果…</view>
  <view class="error-message" wx:if="{{error}}">{{error}}</view>
  <block wx:if="{{appointment}}">
    <appointment-summary appointment="{{appointment}}" />
    <view class="section">
      <view class="field-label">门店联系</view>
      <view class="info-line" wx:if="{{appointment.address}}"><image src="/assets/pin.png" /><text selectable="true">{{appointment.address}}</text></view>
      <view class="clinic-phone" wx:if="{{appointment.clinicPhone}}"><text selectable="true">电话 {{appointment.clinicPhone}}</text><button bindtap="call">拨打电话</button></view>
      <view class="form-hint" wx:if="{{!appointment.address && !appointment.clinicPhone}}">请联系预约门店前台核对本次安排。</view>
    </view>
    <view class="section">
      <view class="field-label">预约金</view>
      <view wx:if="{{deposit}}">¥{{deposit.amount}} · {{depositLabel}}</view>
      <view wx:if="{{refund}}">退金 ¥{{refund.amount}} · {{refundLabel}}</view>
      <view wx:if="{{changeDeadline}}" class="form-hint">患者原因改期最晚 {{changeDeadline}}</view>
      <view wx:if="{{calendarIssue}}" class="form-hint">请联系门店核对患者原因改期截止。</view>
      <view wx:if="{{contactClinic}}" class="form-hint">如需取消，请先由门店核实。</view>
    </view>
    <view wx:if="{{invoiceError}}" class="state state-error">
      <view class="state-title">暂时无法读取诊疗费用单</view><text>{{invoiceError}}</text>
      <button class="mini-button" bindtap="loadInvoice">重新查询费用单</button>
    </view>
    <button wx:if="{{invoiceId}}" class="secondary-action" bindtap="openInvoice">查看诊疗费用单</button>
    <button wx:if="{{canReschedule}}" class="secondary-action" bindtap="reschedule">改期</button>
    <button wx:if="{{canCancel}}" class="text-action" bindtap="cancel">取消预约</button>
    <button class="primary-action" bindtap="all">查看我的预约</button>
  </block>
</view>
