.summary{box-sizing:border-box;background:#fff;border:1px solid #dce8e9;border-radius:16px;padding:17px;color:#183c48;text-align:left;font-size:14px;line-height:1.5}
.first-line,.row,.when,.foot{display:flex;align-items:center;gap:8px}.first-line,.foot{justify-content:space-between}.project{font-size:18px;font-weight:650;line-height:1.4}.status{flex:none;border-radius:6px;padding:3px 8px;color:#116c68;background:#e2f3ec;font-size:12px;font-weight:600}.s-CANCELLED,.s-NO_SHOW,.s-COMPLETED{color:#526877;background:#edf1f4}.s-IN_TREATMENT,.s-CHECKED_IN{background:#dceffa;color:#206080}.when{margin:12px 0 9px;flex-wrap:wrap;color:#194b58}.date{font-weight:650}.row{margin-top:5px;color:#375c67}.row image{width:17px;height:17px;flex:none}.address{margin:3px 0 6px 25px;color:#62757c;font-size:13px}.foot{border-top:1px dashed #dae5e5;margin-top:13px;padding-top:10px;color:#657c84;font-size:12px;word-break:break-all}.more{font-size:20px;color:#177f81}
