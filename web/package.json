{
  "name": "adc-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --disable-warning=ExperimentalWarning --test tests/project.test.mjs && vitest run --environment jsdom --exclude tests/project.test.mjs",
    "build:demo": "tsc --noEmit && vite build --config vite.demo.config.ts",
    "dev:demo": "vite --config vite.demo.config.ts"
  },
  "dependencies": {
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.7"
  }
}
