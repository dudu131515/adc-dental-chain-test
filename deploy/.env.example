ADC_ENV=experience
ADC_ALLOWED_HOSTS=adc.example.invalid
ADC_SECRET_KEY=
ADC_BUSINESS_DB_URL=postgresql://adc_app@postgres.internal/adc_business?sslmode=verify-full
ADC_RUNTIME_DB_URL=postgresql://adc_app@postgres.internal/adc_runtime?sslmode=verify-full
ADC_STAFF_PASSWORD_HASHES={}
ADC_WECHAT_APP_ID=
ADC_WECHAT_SECRET=
ADC_WORK_CALENDARS_PATH=/etc/adc/work-calendars.json
ADC_MATERIAL_COSTS_PATH=/etc/adc/material-costs.json
ADC_SIMULATION_PAUSED=1
ADC_SIMULATION_OUTCOMES={}

# Enable for a dedicated synthetic business database. These settings must match ADC_BUSINESS_DB_URL.
# Store the real key in the backend service environment, for example /etc/adc/assistant.env with mode 0600.
# See deploy/README.md for setup and verification.
ADC_ASSISTANT_DEEPSEEK_ENABLED=0
ADC_ASSISTANT_SYNTHETIC_ENV=
ADC_ASSISTANT_SYNTHETIC_HOST=
ADC_ASSISTANT_SYNTHETIC_PORT=
ADC_ASSISTANT_SYNTHETIC_DB=
ADC_DEEPSEEK_API_KEY=
ADC_DEEPSEEK_MODEL=deepseek-flash
